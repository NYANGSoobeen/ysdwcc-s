rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function members(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data.members;
    }

    // 관리자가 사용 중지한 계정(users.active == false)은 로그인 토큰이 남아 있어도 팀 데이터를 못 쓴다.
    // (프로필 문서가 없는 경우는 막지 않는다: 팀 소속은 teams.members가 따로 확인한다.)
    function isActive() {
      let user = /databases/$(database)/documents/users/$(request.auth.uid);
      return !exists(user) || get(user).data.get('active', true) != false;
    }

    function isMember(teamId) {
      return signedIn() && request.auth.uid in members(teamId) && isActive();
    }

    function canEdit(teamId) {
      return isMember(teamId) && members(teamId)[request.auth.uid] in ['admin', 'editor'];
    }

    function isAdmin(teamId) {
      return isMember(teamId) && members(teamId)[request.auth.uid] == 'admin';
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // 채팅 메시지 수정: 작성자는 글(수정, 삭제 표시)을, 팀원은 누구나 자기 스티커(공감)만 바꾼다.
    // reactions = { uid: "👍" } — 남의 스티커는 건드릴 수 없다.
    function canUpdateMessage(teamId) {
      return (canEdit(teamId)
          && resource.data.authorUid == request.auth.uid
          && unchanged('authorUid')
          && unchanged('createdAt')
          && request.resource.data.get('reactions', {}) == resource.data.get('reactions', {}))
        || (isMember(teamId)
          && onlyChanges(['reactions'])
          && request.resource.data.reactions
            .diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.reactions)
            || request.resource.data.reactions[request.auth.uid] in ['👍', '❤️', '😂', '😮', '😢', '🙏', '✅']));
    }

    // 이름 표시를 위해 로그인한 사용자는 서로의 프로필을 읽을 수 있다.
    // (사용 중지된 사람도 자기 문서는 읽어야 중지 이유를 보고 로그아웃할 수 있다.)
    // 프로필은 Functions가 만들고, 본인은 이름과 설정만 바꿀 수 있다
    // (teamIds, active, mustChangePassword 등은 바꿀 수 없음).
    // 푸시 알림 받을 기기 (문서 id = 토큰의 sha256). 본인 것만 만들고 지운다.
    // 같은 기기를 다른 사람이 쓰게 되면(토큰 같음) 그 사람 것으로 바꿀 수 있다. 앱은 남의 토큰을 읽을 수 없다.
    match /pushTokens/{tokenId} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn() && isActive()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'token', 'platform', 'mode', 'updatedAt'])
        && request.resource.data.token is string && request.resource.data.token.size() < 4096
        && request.resource.data.platform in ['web', 'android']
        && request.resource.data.mode in ['all', 'mentions']
        && request.resource.data.updatedAt == request.time
        && (resource == null || resource.data.token == request.resource.data.token);
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow update: if signedIn() && request.auth.uid == uid && isActive()
        && onlyChanges(['name', 'platform', 'settings']);

      // 연락처 동기화 상태 등 본인만 보는 정보. Functions만 쓴다.
      match /private/{docId} {
        allow read: if signedIn() && request.auth.uid == uid;
      }
    }

    // carddavTokens(연락처 동기화 접속 정보)와 meta는 앱에서 접근할 수 없다 (규칙 없음 = 거부).

    match /teams/{teamId} {
      allow read: if isMember(teamId);
      // 팀 생성과 팀원 추가, 권한 변경, 삭제는 Functions만 한다 (Auth 계정과 함께 바뀌어야 함).
      // 관리자는 팀 이름과 공유 설정만 직접 바꿀 수 있다.
      allow update: if isAdmin(teamId)
        && onlyChanges(['name', 'autoShare', 'shareNotes']);

      // 근무표(스케줄): 팀마다 문서 하나(current). 올리기·이름 변경·삭제는 편집 이상,
      // 수정 표시 스티커(marks)는 팀원 모두 붙이고 뗄 수 있다.
      match /schedule/{docId} {
        allow read: if isMember(teamId);
        allow create: if canEdit(teamId)
          && request.resource.data.authorId == request.auth.uid;
        allow update: if canEdit(teamId)
          || (isMember(teamId)
            && onlyChanges(['marks', 'marksAt', 'marksBy'])
            && request.resource.data.marksBy == request.auth.uid);
        allow delete: if canEdit(teamId);
      }

      match /messages/{msgId} {
        allow read: if isMember(teamId);
        allow create: if canEdit(teamId)
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if canUpdateMessage(teamId);
        // 삭제는 작성자만, 그리고 바로 영구 삭제한다 (첨부 사진은 Functions가 지운다).
        allow delete: if isMember(teamId)
          && resource.data.authorUid == request.auth.uid;
      }

      // 단체 채팅방. 기본 방(main)의 메시지는 위의 teams/{teamId}/messages에 있고,
      // channels/main 문서는 기본 방 이름을 바꿀 때만 생긴다. 기본 방은 지울 수 없다.
      // 방을 지우면 Functions(onChannelDeleted)가 방의 메시지와 사진을 지운다.
      match /channels/{channelId} {
        function validName() {
          return request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 30;
        }

        allow read: if isMember(teamId);
        allow create: if canEdit(teamId) && validName()
          && request.resource.data.createdBy == request.auth.uid
          && (channelId != 'main' || isAdmin(teamId));
        allow update: if validName() && onlyChanges(['name'])
          && (isAdmin(teamId) || (canEdit(teamId) && resource.data.createdBy == request.auth.uid));
        allow delete: if channelId != 'main'
          && (isAdmin(teamId) || (canEdit(teamId) && resource.data.createdBy == request.auth.uid));

        // 읽음 표시: 방마다 팀원별 마지막으로 읽은 시각. 팀원 모두 보고, 자기 것만 쓴다 (지금보다 미래 시각은 안 됨).
        // (기본 방은 channels/main/reads, main 문서가 없어도 된다)
        match /reads/{readerUid} {
          allow read: if isMember(teamId);
          allow create, update: if isMember(teamId) && readerUid == request.auth.uid
            && request.resource.data.keys().hasOnly(['at'])
            && request.resource.data.at is timestamp
            && request.resource.data.at <= request.time;
        }

        match /messages/{msgId} {
          allow read: if isMember(teamId);
          allow create: if canEdit(teamId)
            && request.resource.data.authorUid == request.auth.uid;
          allow update: if canUpdateMessage(teamId);
          allow delete: if isMember(teamId)
            && resource.data.authorUid == request.auth.uid;
        }
      }
    }

    match /customers/{customerId} {
      function customerTeam() {
        return get(/databases/$(database)/documents/customers/$(customerId)).data.teamId;
      }

      allow read: if isMember(resource.data.teamId);
      allow create: if canEdit(request.resource.data.teamId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if canEdit(resource.data.teamId)
        && unchanged('teamId')
        && unchanged('createdBy')
        && unchanged('createdAt');
      // 고객 삭제는 관리자 또는 담당자만. 메모와 수정 기록은 Functions가 함께 지운다.
      allow delete: if isAdmin(resource.data.teamId)
        || (canEdit(resource.data.teamId) && resource.data.ownerUid == request.auth.uid);

      match /notes/{noteId} {
        allow read: if isMember(customerTeam());
        allow create: if canEdit(customerTeam())
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if canEdit(customerTeam())
          && unchanged('authorUid')
          && unchanged('createdAt')
          && request.resource.data.editedBy == request.auth.uid;
        allow delete: if isAdmin(customerTeam())
          || (canEdit(customerTeam()) && resource.data.authorUid == request.auth.uid);

        // 수정 기록은 추가만 가능하다. 메모가 삭제되면 Functions가 함께 지운다.
        match /revisions/{revId} {
          allow read: if isMember(customerTeam());
          allow create: if canEdit(customerTeam())
            && request.resource.data.editedBy == request.auth.uid;
        }
      }
    }
  }
}
