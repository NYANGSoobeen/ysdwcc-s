rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // 사용 중지된 계정(users.active == false)은 막는다.
    function active() {
      let user = /databases/(default)/documents/users/$(request.auth.uid);
      return !firestore.exists(user) || firestore.get(user).data.get('active', true) != false;
    }

    function role(teamId) {
      return active() ? firestore.get(/databases/(default)/documents/teams/$(teamId)).data.members[request.auth.uid] : null;
    }

    // 😊 이모티콘 그림 (모든 팀 공용): 로그인한 직원은 보고, 최고 관리자만 올리고 지운다.
    // PNG·JPG·WebP는 앱이 256px로 줄여 올리고, 움직이는 GIF는 원본 그대로 1MB까지. 문서를 지우면 Functions가 그림도 지운다.
    match /stickers/{fileName} {
      allow read: if request.auth != null && active();
      allow create: if request.auth != null && active()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('superAdmin', false) == true
        && request.resource.contentType.matches('image/(png|gif|jpeg|webp)')
        && request.resource.size <= 1024 * 1024;
      allow delete: if request.auth != null && active()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('superAdmin', false) == true;
    }

    // 근무표(스케줄): 쪽 그림(PNG/JPEG)과 원본 PDF(1MB 이하만). 교체·삭제 시 Functions가 폴더째 지운다.
    match /teams/{teamId}/schedule/{uploadId}/{fileName} {
      allow read: if request.auth != null
        && active()
        && request.auth.uid in firestore.get(/databases/(default)/documents/teams/$(teamId)).data.members;
      allow create: if request.auth != null
        && role(teamId) in ['admin', 'editor']
        && request.resource.metadata.uploaderUid == request.auth.uid
        && ((request.resource.contentType.matches('image/(png|jpeg)') && request.resource.size < 12 * 1024 * 1024)
          || (request.resource.contentType == 'application/pdf' && request.resource.size <= 1024 * 1024));
      // 저장이 중간에 실패했을 때 올린 사람이 직접 정리할 수 있게 한다.
      allow delete: if request.auth != null
        && resource.metadata.uploaderUid == request.auth.uid;
    }

    // 📢 공지 사진: 압축본과 썸네일 (2MB 미만 JPEG). 공지를 고치거나 지우면 Functions가 안 쓰는 사진을 지운다.
    match /teams/{teamId}/notices/{noticeId}/{fileName} {
      allow read: if request.auth != null
        && active()
        && request.auth.uid in firestore.get(/databases/(default)/documents/teams/$(teamId)).data.members;
      allow create: if request.auth != null
        && role(teamId) in ['admin', 'editor']
        && request.resource.metadata.uploaderUid == request.auth.uid
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size < 2 * 1024 * 1024;
      allow delete: if request.auth != null
        && resource.metadata.uploaderUid == request.auth.uid;
    }

    // 채팅 사진: 압축본과 썸네일. 메시지가 삭제되면 Functions가 폴더째 지운다.
    match /teams/{teamId}/chat/{msgId}/{fileName} {
      allow read: if request.auth != null
        && active()
        && request.auth.uid in firestore.get(/databases/(default)/documents/teams/$(teamId)).data.members;
      // 사진(압축본·썸네일, 동영상 첫 장면 v_0_poster.jpg): 2MB 미만 그림. 파일(f_번호.확장자): 엑셀·PDF·한글·워드·파워포인트·압축·텍스트, 10MB 이하.
      // 동영상(v_번호.확장자): 원본 그대로 50MB 이하 (src/chat.ts VIDEO_MAX_BYTES와 같게).
      allow create: if request.auth != null
        && role(teamId) in ['admin', 'editor']
        && request.resource.metadata.uploaderUid == request.auth.uid
        && ((!fileName.matches('f_.*')
            && request.resource.size < 2 * 1024 * 1024
            && request.resource.contentType.matches('image/.*'))
          || (fileName.matches('f_[0-9]+[.](xls|xlsx|csv|pdf|hwp|hwpx|doc|docx|ppt|pptx|zip|txt)')
            && request.resource.size <= 10 * 1024 * 1024)
          || (fileName.matches('v_[0-9]+[.](mp4|mov|m4v|webm|3gp)')
            && request.resource.contentType.matches('video/.*')
            && request.resource.size <= 50 * 1024 * 1024));
      // 메시지 저장에 실패했을 때 올린 사람이 직접 정리할 수 있게 한다.
      allow delete: if request.auth != null
        && resource.metadata.uploaderUid == request.auth.uid;
    }
  }
}
